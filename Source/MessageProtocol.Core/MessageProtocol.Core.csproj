<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>MessageProtocol.Core</PackageId>
    <Description>Runtime half of the MessageProtocol binary serialization library: the MessageSerializer API — registration, dispatch, generic hot paths with delegate caches, and pooled buffers — plus the message contract attributes and interfaces.

Standalone it falls back to reflection; for compile-time generated serializers install the main MessageProtocol package (bundles this runtime and the source generator) or add MessageProtocol.CodeGenerator alongside.

Targets netstandard2.1 (Unity-compatible) and net6.0+.</Description>
    <PackageTags>serialization;binary;unity;game;networking;messages</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- net6+ 소비자는 ModuleInitializer polyfill을 보지 않아야 함 (CS0433 방지) -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\MessageFlag.cs" Link="MessageFlag.cs" />
    <Compile Include="..\Shared\MessageKind.cs" Link="MessageKind.cs" />
    <Compile Include="..\Shared\MessageWireFormat.cs" Link="MessageWireFormat.cs" />
    <Compile Include="..\Shared\MessageIdHash.cs" Link="MessageIdHash.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- 버퍼 용량 산술(KI-22) 같은 내부 계약을 회귀 테스트가 직접 검증하도록 노출 -->
    <InternalsVisibleTo Include="MessageProtocol.Tests" />
  </ItemGroup>

</Project>
