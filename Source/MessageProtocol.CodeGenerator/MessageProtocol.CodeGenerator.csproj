<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>MessageProtocol.CodeGenerator</PackageId>
    <Description>Roslyn source generator for the MessageProtocol serialization library: emits Serialize/Deserialize implementations, message IDs, and self-registration code for [Message]-decorated partial types at compile time, and reports MSGPROT0xx diagnostics for invalid message declarations.

Analyzer-only package (netstandard2.0). For most apps, install the main MessageProtocol package instead — it pulls this in automatically.</Description>
    <PackageTags>roslyn;source-generator;code-generation;analyzer;serialization</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- RS2007(잘못된 릴리스 헤더)·RS2008(추적 누락) 을 빌드 실패로 승격 - 마크다운 자동 서식 도구가
         AnalyzerReleases.*.md 의 테이블 구분 행(파이프 주변 공백 없는 형태)을 공백 포함 형태로 바꾸면
         릴리스 추적 파서가 읽지 못하는데, 이 형태의 파손이 이 저장소에서 실제 재발한 이력이 있다
         (KI-12, 2026-09-07/09-08 두 차례). 경고로만 남으면 클린 빌드에서만 보이고 CI 를 통과하므로 게이트한다. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS2007;RS2008</WarningsAsErrors>

    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <DefineConstants>$(DefineConstants);MESSAGE_PROTOCOL_CODE_GENERATOR</DefineConstants>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- 분석기 전용 패키지(lib 없음)로 인한 NU5128 -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- IncludeBuildOutput=false 지만 Pack 시 분석기 DLL을 analyzers/dotnet/cs 로 포함 -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddAnalyzerAssemblyToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="AddAnalyzerAssemblyToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynAnalyzerApiVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!-- 분석기 릴리스 추적(RS2008): AnalyzerReleases.Shipped.md · AnalyzerReleases.Unshipped.md 는
       SDK 가 자동으로 AdditionalFiles 에 포함하므로 별도 선언하지 않는다(중복 전달 방지). -->

  <ItemGroup>
    <!-- 생성 이미터 단위 테스트가 내부 진입점(TryEmit)을 직접 구동한다 -->
    <InternalsVisibleTo Include="MessageProtocol.Tests" />
  </ItemGroup>


  <ItemGroup>
    <Compile Include="..\Shared\MessageFlag.cs" Link="MessageFlag.cs" />
    <Compile Include="..\Shared\MessageKind.cs" Link="MessageKind.cs" />
    <Compile Include="..\Shared\MessageWireFormat.cs" Link="MessageWireFormat.cs" />
    <Compile Include="..\Shared\MessageIdHash.cs" Link="MessageIdHash.cs" />
  </ItemGroup>

</Project>
