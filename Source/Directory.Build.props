<Project>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.1.0</Version>
    <Authors>BIGSUNGG</Authors>
    <RepositoryUrl>https://github.com/BIGSUNGG/DS_MessageProtocol</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 공개 API 미문서화 시 빌드 실패 방지 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    제너레이터가 참조하는 Roslyn 컴파일러 API 버전.
    Unity 에디터(6.0 LTS = Roslyn 4.3)용 재빌드 시 -p:RoslynAnalyzerApiVersion=4.3.0 으로 오버라이드한다.
    (CS9057: 분석기가 호스트 컴파일러보다 새 Roslyn 을 참조하면 Unity 가 제너레이터를 스킵한다)
  -->
  <PropertyGroup>
    <RoslynAnalyzerApiVersion>4.14.0</RoslynAnalyzerApiVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 저장소 루트 README를 패키지에 포함 -->
    <None Include="$(MSBuildThisFileDirectory)..\README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>
</Project>
