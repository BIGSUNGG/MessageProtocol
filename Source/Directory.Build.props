<Project>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>3.2.1</Version>
    <Authors>BIGSUNGG</Authors>
    <RepositoryUrl>https://github.com/BIGSUNGG/DS_MessageProtocol</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 공개 API 미문서화 시 빌드 실패 방지 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    제너레이터가 참조하는 Roslyn 컴파일러 API 버전.
    기본 4.3.0 — Unity 6.0 LTS(에디터 번들 Roslyn 4.3)에서 CS9057 스킵 없이 바로 로드되도록 한다.
    구버전 참조는 상위 컴파일러(4.14 포함)에서도 하위호환 동작하므로 최신 SDK 소비자도 동일 패키지를 쓴다.
    필요 시 -p:RoslynAnalyzerApiVersion=<버전> 으로 상향 오버라이드.
  -->
  <PropertyGroup>
    <RoslynAnalyzerApiVersion>4.3.0</RoslynAnalyzerApiVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 저장소 루트 README를 패키지에 포함 -->
    <None Include="$(MSBuildThisFileDirectory)..\README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>
</Project>
